{
	"name": "password-generator",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"check-types": "turbo run check-types",
		"build:dev:android": "pnpm run --filter=mobile build:dev:android",
		"start:dev:android": "pnpm run --filter=mobile start",
		"build:prod:android": "pnpm run --filter=mobile build:prod:android",
		"format": "prettier --write .",
		"lint": "eslint . && stylelint **/*.{css,scss} --fix",
		"clean": "clean:node_modules && clean:turbo && clean:build",
		"clean:turbo": "rm -rf .turbo",
		"clean:build": "rm -rf apps/mobile/.expo && rm -rf apps/web/.next",
		"clean:node_modules": "rm -rf node_modules && rm -rf apps/**/node_modules",
		"nuke": "pnpm clean && pnpm store prune",
		"web:build": "pnpm run --filter=web build",
		"web:dev": "pnpm run --filter=web dev",
		"web:start": "pnpm run --filter=web start",
		"mobile:dev": "pnpm run --filter=mobile dev"
	},
	"keywords": [],
	"author": "",
	"license": "GPL-3.0",
	"packageManager": "pnpm@10.26.2",
	"devDependencies": {
		"@eslint/css": "0.14.1",
		"@eslint/js": "9.39.2",
		"@eslint/json": "0.14.0",
		"@eslint/markdown": "7.5.1",
		"eslint": "9.39.2",
		"eslint-plugin-react": "7.37.5",
		"globals": "17.0.0",
		"jiti": "2.6.1",
		"lefthook": "2.0.13",
		"prettier": "3.7.4",
		"rimraf": "6.1.2",
		"stylelint": "16.26.1",
		"stylelint-config-standard": "39.0.1",
		"stylelint-config-tailwindcss": "1.0.0",
		"turbo": "2.7.2",
		"typescript-eslint": "8.51.0"
	}
}

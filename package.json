{
	"name": "password-generator",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"check-types": "turbo run check-types",
		"format": "prettier --write .",
		"lint": "eslint . && stylelint **/*.{css,scss}",
		"lint-fix": "eslint . --fix && stylelint **/*.{css,scss} --fix",
		"clean": "pnpm clean-modules & pnpm clean-turbo & pnpm clean-build",
		"clean-modules": "rm -rf node_modules && rm -rf apps/**/node_modules",
		"clean-turbo": "rm -rf .turbo **/.turbo",
		"clean-build": "rm -rf apps/mobile/.expo apps/web/.next packages/**/dist",
		"nuke": "pnpm clean && pnpm store prune",
		"wb": "pnpm run --filter=web build",
		"wd": "pnpm run --filter=web dev",
		"ws": "pnpm run --filter=web start",
		"ms": "pnpm run --filter=mobile start",
		"mobile-build-dev-android": "pnpm run --filter=mobile build-dev-android",
		"mobile-build-prod-android": "pnpm run --filter=mobile build-prod-android",
		"mobile-build-dev-ios": "pnpm run --filter=mobile build-dev-ios",
		"mobile-build-prod-ios": "pnpm run --filter=mobile build-prod-ios",
		"mobile-build-dev": "pnpm run --filter=mobile build-dev",
		"mobile-build-prod": "pnpm run --filter=mobile build-prod",
		"compile": "pnpm -F \"@passfe/*\" build",
		"check": "pnpm format && pnpm lint && pnpm check-types",
		"ric": "pnpm clean && pnpm install && pnpm compile",
		"rib": "bash scripts/ri.sh",
		"va": "pnpm check-types && pnpm lint && pnpm format"
	},
	"keywords": [],
	"author": "",
	"license": "GPL-3.0",
	"packageManager": "pnpm@10.28.0",
	"devDependencies": {
		"@eslint/css": "0.14.1",
		"@eslint/js": "9.39.2",
		"@eslint/json": "0.14.0",
		"@eslint/markdown": "7.5.1",
		"@rollup/plugin-commonjs": "29.0.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"eslint": "9.39.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "17.0.0",
		"jiti": "2.6.1",
		"lefthook": "2.0.13",
		"prettier": "3.7.4",
		"rollup": "4.54.0",
		"rollup-plugin-dts": "6.3.0",
		"stylelint": "16.26.1",
		"stylelint-config-standard": "39.0.1",
		"stylelint-config-tailwindcss": "1.0.0",
		"turbo": "2.7.2",
		"typescript-eslint": "8.51.0"
	},
	"dependencies": {
		"fast-equals": "^6.0.0",
		"tailwind-merge": "^3.4.0",
		"zustand": "5.0.11"
	}
}
